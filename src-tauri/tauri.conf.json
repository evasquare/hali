{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "productName": "hali",
  "mainBinaryName": "hali",
  "version": "0.0.0",
  "identifier": "com.evasquare.hali",
  "plugins": {},
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "resizable": true,
        "title": "Hali",
        "width": 400,
        "height": 400,
        "minWidth": 400,
        "maxWidth": 400,
        "minHeight": 500,
        "maxHeight": 10000,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}